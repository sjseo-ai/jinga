{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/weekly.mjs": {
      "maxDuration": 300
    },
    "api/stock-analysis.mjs": {
      "maxDuration": 300
    },
    "api/market-flow.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/weekly",
      "schedule": "30 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/unsubscribe",
      "destination": "/api/subscribe?action=unsubscribe"
    },
    {
      "source": "/api/confirm",
      "destination": "/api/subscribe?action=confirm"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/r/:date/:file",
      "destination": "/api/report?date=:date&file=:file"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(index.html|sw.js|manifest.json)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)\\.mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
